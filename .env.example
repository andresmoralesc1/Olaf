# Copy this to .env and fill in real values. .env is gitignored.

# Translation TMS login credentials.
TRANSLATION_TMS_EMAIL=
TRANSLATION_TMS_PASSWORD=

# Override if the login page lives elsewhere. Default: /login.
# TRANSLATION_TMS_LOGIN_URL=https://www.translationtms.com/login

# Override the job-board target if you want a different filter view.
# Default: in-progress tab.
# JOB_BOARD_URL=https://www.translationtms.com/job-board?locales=&statuses=&projectIds=&jobTab=inProgress&tab=job

# Container port (Caddy reverse-proxies here). Default 3018.
# PORT=3018